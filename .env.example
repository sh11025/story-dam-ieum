# 이 파일을 복사해 .env 로 만들거나, Render의 Environment 설정에 같은 이름으로 넣으세요.
# 실제 값이 들어간 .env 파일은 깃허브에 올라가지 않습니다(.gitignore).

# 관리자 저장소(깃허브)의 공지 파일 주소. 관리자 화면 아래쪽 "사용자 사이트 연결"에서 복사할 수 있어요.
# 예) https://raw.githubusercontent.com/내아이디/story-dam-ieum-admin/main/data/notices.json
NOTICES_URL=

# AI 첨삭에 쓸 모델 이름(선택). 비워 두면 해당 AI는 "연결되지 않음"으로 안내돼요.
# AI 키는 사용자가 화면에서 직접 입력하고, 서버에는 저장하지 않아요.
AI_OPENAI_MODEL=
AI_GEMINI_MODEL=
AI_CLAUDE_MODEL=
